{
  "name": "neuralcards",
  "compatibility_date": "2026-09-16",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "main": "vinext/server/fetch-handler",
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" }
}